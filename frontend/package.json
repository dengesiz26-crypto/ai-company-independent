from __future__ import annotations

import base64
import json
import os
from urllib.parse import urlencode

import httpx
from google.auth.transport.requests import Request
from google.oauth2.credentials import Credentials
from google_auth_oauthlib.flow import InstalledAppFlow
from googleapiclient.discovery import build

SCOPES = ["https://www.googleapis.com/auth/gmail.readonly", "https://www.googleapis.com/auth/gmail.send"]


def _credentials() -> dict | None:
    client_id = os.getenv("GOOGLE_CLIENT_ID")
    client_secret = os.getenv("GOOGLE_CLIENT_SECRET")
    if not client_id or not client_secret:
        return None
    return {"client_id": client_id, "client_secret": client_secret}


def build_oauth_url() -> str:
    creds = _credentials()
    if not creds:
        return "https://accounts.google.com/o/oauth2/v2/auth?error=missing_google_credentials"
    params = {
        "client_id": creds["client_id"],
        "redirect_uri": os.getenv("GOOGLE_REDIRECT_URI", "http://localhost:8000/api/gmail/callback"),
        "response_type": "code",
        "scope": " ".join(SCOPES),
        "access_type": "offline",
        "prompt": "consent",
    }
    return "https://accounts.google.com/o/oauth2/v2/auth?" + urlencode(params)


async def exchange_code(code: str, state: str | None = None) -> dict:
    creds = _credentials()
    if not creds:
        return {"status": "requires_configuration", "message": "Google OAuth credentials not configured"}

    data = {
        "code": code,
        "client_id": creds["client_id"],
        "client_secret": creds["client_secret"],
        "redirect_uri": os.getenv("GOOGLE_REDIRECT_URI", "http://localhost:8000/api/gmail/callback"),
        "grant_type": "authorization_code",
    }
    async with httpx.AsyncClient() as client:
        response = await client.post("https://oauth2.googleapis.com/token", data=data)
        response.raise_for_status()
        token = response.json()

    creds_obj = Credentials(token={
        "access_token": token.get("access_token"),
        "refresh_token": token.get("refresh_token"),
        "token_uri": "https://oauth2.googleapis.com/token",
        "client_id": creds["client_id"],
        "client_secret": creds["client_secret"],
        "scopes": SCOPES,
    })
    profile = build("gmail", "v1", credentials=creds_obj)
    profile_info = profile.users().getProfile(userId="me").execute()
    return {"email": profile_info.get("emailAddress"), "credentials": token}


async def list_gmail_messages() -> dict:
    creds = _credentials()
    if not creds:
        return {"status": "not_configured"}
    return {"status": "available", "message": "Gmail integration module is ready. Configure Google OAuth to enable live mail reading."}


async def send_gmail_message(to: str, subject: str, body: str) -> dict:
    creds = _credentials()
    if not creds:
        return {"status": "requires_configuration", "message": "Google OAuth credentials not configured"}

    message = (
        "From: me\n"
        f"To: {to}\n"
        f"Subject: {subject}\n\n"
        f"{body}"
    )
    encoded = base64.urlsafe_b64encode(message.encode("utf-8")).decode("ascii")
    return {"status": "prepared", "message_id": encoded, "to": to, "subject": subject, "body": body}
